module(
    name = "firewood",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.63.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.69.0")
bazel_dep(name = "rules_cc", version = "0.2.17")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.95.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "firewood_crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)

# crate_universe does not discover optional dependencies selected only by the
# Bazel feature sets below.
crate.spec(
    package = "bytes",
    version = "1.11.1",
)
crate.spec(
    features = ["kv"],
    package = "log",
    version = "0.4.29",
)
crate.spec(
    package = "rlp",
    version = "0.6.1",
)
crate.spec(
    package = "sha3",
    version = "0.12.0",
)
use_repo(crate, "firewood_crates")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//ffi:go.mod")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//ffi:go.mod")
use_repo(
    go_deps,
    "com_github_prometheus_client_golang",
    "com_github_prometheus_client_model",
    "com_github_stretchr_testify",
    "com_github_vmihailenco_msgpack_v5",
    "org_golang_x_sync",
    "org_golang_x_tools",
)
