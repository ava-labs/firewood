module(
    name = "firewood",
    # This source-only module is consumed through git_override, not a BCR release.
    version = "0.0.0",
)

# The FFI exposes a Rust static library through CGO. Gazelle resolves its Go
# dependencies, rules_rust compiles the library and its Cargo dependencies, and
# rules_cc links the platform C libraries that the static library needs.
bazel_dep(name = "rules_go", version = "0.63.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.69.0")
bazel_dep(name = "rules_cc", version = "0.2.17")

# Keep the Bazel compiler aligned with Cargo's MSRV. The root module selects
# the toolchain when Firewood is a dependency; this registration serves direct
# builds of this repository.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    sha256s = {
        # BEGIN GENERATED RUST TOOLCHAIN SHA256S
        # Generated by scripts/update-bazel-rust-toolchain-shas.sh.
        "cargo-1.100.0-aarch64-unknown-linux-gnu.tar.xz": "d07ee80eb6ba3c5845c554ac88086e1ff5d63f83d99c3c09cb32504cbedd6844",
        "cargo-1.100.0-x86_64-unknown-linux-gnu.tar.xz": "7e29ce07d7c6e92d1826870575ba27d57fff6cb3e754aa57d99099cb88fab35d",
        "clippy-1.100.0-aarch64-unknown-linux-gnu.tar.xz": "941f71acaf2a181d66776b3b889b72d64a90cc405b8f6c41a4b5ac8cd99a36b1",
        "clippy-1.100.0-x86_64-unknown-linux-gnu.tar.xz": "0d18df3bff6c852ef8243727fed075ecb33dbf93b8ab8c138c2f45e3f270102a",
        "llvm-tools-1.100.0-aarch64-unknown-linux-gnu.tar.xz": "929514c642010b884575525fce876d3fb9b9eeec76cd825b79b3b917a7088fc6",
        "llvm-tools-1.100.0-x86_64-unknown-linux-gnu.tar.xz": "2c84cada1aef73339b1a2d101a35cd78d71072c8f6a3921bf1abb852c3f42ad3",
        "rust-std-1.100.0-aarch64-unknown-linux-gnu.tar.xz": "c73f62fbe5d837f9807ed9e0076575dd8d3475c79af2b30e3570d328e6713f8f",
        "rust-std-1.100.0-x86_64-unknown-linux-gnu.tar.xz": "4591b6486594ded52ecd6135db95bf9355bbd3ca7a380888b141528bbcf9a5d4",
        "rustc-1.100.0-aarch64-unknown-linux-gnu.tar.xz": "fcbfa5b8a0cb28f0c4edfb6dda6910ee910993db31f05258613f5cd5b851263a",
        "rustc-1.100.0-x86_64-unknown-linux-gnu.tar.xz": "f1d0b1dec81dab6f523cd098507763487b0d4bd7fd2c87582f154128719be03b",
        # END GENERATED RUST TOOLCHAIN SHA256S
    },
    versions = ["1.100.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Cargo.lock remains the source of truth for Rust dependency resolution.
# crate_universe converts that resolved graph into Bazel repositories.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "firewood_crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)

# These crates are used by the hand-written Bazel targets but may not be in
# crate_universe's default feature graph. Keep each version aligned with
# Cargo.lock so `bazel mod tidy` can regenerate MODULE.bazel.lock.
crate.spec(
    package = "bytes",
    version = "1.11.1",
)
crate.spec(
    features = ["kv"],
    package = "log",
    version = "0.4.29",
)
crate.spec(
    package = "rlp",
    version = "0.6.1",
)
crate.spec(
    package = "sha3",
    version = "0.12.0",
)
use_repo(crate, "firewood_crates")

# Derive the Go SDK and external repositories from the FFI module so Bazel and
# ordinary Go builds resolve the same direct dependencies.
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//ffi:go.mod")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//ffi:go.mod")
use_repo(
    go_deps,
    "com_github_prometheus_client_golang",
    "com_github_prometheus_client_model",
    "com_github_stretchr_testify",
    "com_github_vmihailenco_msgpack_v5",
    "org_golang_x_sync",
    "org_golang_x_tools",
)
