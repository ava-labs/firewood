# gazelle:ignore

load("@firewood_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "firewood-ethhash",
    srcs = glob(["src/**/*.rs"]),
    crate_features = [
        "ethhash",
        "logger",
    ],
    crate_name = "firewood",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = [
        "//firewood-macros",
    ] + all_crate_deps(
        proc_macro = True,
        package_name = "firewood",
    ),
    visibility = ["//:__subpackages__"],
    deps = [
        "//metrics:firewood-metrics",
        "//storage:firewood-storage-ethhash",
    ] + all_crate_deps(package_name = "firewood"),
)

rust_library(
    name = "firewood-merkledb",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["logger"],
    crate_name = "firewood",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = [
        "//firewood-macros",
    ] + all_crate_deps(
        proc_macro = True,
        package_name = "firewood",
    ),
    visibility = ["//:__subpackages__"],
    deps = [
        "//metrics:firewood-metrics",
        "//storage:firewood-storage-merkledb",
    ] + all_crate_deps(package_name = "firewood"),
)
