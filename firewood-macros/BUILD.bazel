# gazelle:ignore
#
# Firewood's Rust target consumes this procedural-macro crate during compilation.

load("@firewood_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_proc_macro")

rust_proc_macro(
    name = "firewood-macros",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    # The macro is internal to Firewood's Bazel targets.
    visibility = ["//:__subpackages__"],
    deps = all_crate_deps(package_name = "firewood-macros"),
)
