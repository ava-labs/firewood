# gazelle:ignore

load("@firewood_crates//:defs.bzl", "all_crate_deps")
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_static_library")

_RUST_FFI_DEPS = [
    "//firewood:firewood-ethhash",
    "//metrics:firewood-metrics",
    "//storage:firewood-storage-ethhash",
] + all_crate_deps(package_name = "ffi") + [
    "@firewood_crates//:env_logger",
    "@firewood_crates//:log",
] + select({
    "@platforms//os:linux": ["@firewood_crates//:tikv-jemallocator"],
    "@platforms//os:macos": ["@firewood_crates//:tikv-jemallocator"],
    "//conditions:default": [],
})

_RUST_FFI_DEPS_MERKLEDB = [
    "//firewood:firewood-merkledb",
    "//metrics:firewood-metrics",
    "//storage:firewood-storage-merkledb",
] + all_crate_deps(package_name = "ffi") + [
    "@firewood_crates//:env_logger",
    "@firewood_crates//:log",
] + select({
    "@platforms//os:linux": ["@firewood_crates//:tikv-jemallocator"],
    "@platforms//os:macos": ["@firewood_crates//:tikv-jemallocator"],
    "//conditions:default": [],
})

_PLATFORM_LINKOPTS = select({
    "@platforms//os:linux": ["-lm", "-ldl", "-lpthread"],
    "@platforms//os:macos": ["-lm"],
    "//conditions:default": ["-lm"],
})

_GO_SRCS = glob(["*.go"], exclude = ["*_test.go"]) + ["firewood.h"]

_GO_DEPS = [
    "@com_github_prometheus_client_golang//prometheus",
    "@com_github_prometheus_client_model//go",
]

rust_static_library(
    name = "firewood_ffi_rust_ethhash",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["README.md"],
    crate_features = ["logger"],
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _RUST_FFI_DEPS,
)

cc_library(
    name = "firewood_ffi_ethhash",
    hdrs = ["firewood.h"],
    linkopts = _PLATFORM_LINKOPTS,
    visibility = ["//visibility:public"],
    deps = [":firewood_ffi_rust_ethhash"],
)

go_library(
    name = "ffi_ethhash",
    srcs = _GO_SRCS,
    cdeps = [":firewood_ffi_ethhash"],
    cgo = True,
    importpath = "github.com/ava-labs/firewood-go-ethhash/ffi",
    visibility = ["//visibility:public"],
    deps = _GO_DEPS,
)

rust_static_library(
    name = "firewood_ffi_rust_merkledb",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["README.md"],
    crate_features = ["logger"],
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _RUST_FFI_DEPS_MERKLEDB,
)

cc_library(
    name = "firewood_ffi_merkledb",
    hdrs = ["firewood.h"],
    linkopts = _PLATFORM_LINKOPTS,
    visibility = ["//visibility:public"],
    deps = [":firewood_ffi_rust_merkledb"],
)

go_library(
    name = "ffi_merkledb",
    srcs = _GO_SRCS,
    cdeps = [":firewood_ffi_merkledb"],
    cgo = True,
    importpath = "github.com/ava-labs/firewood-go/ffi",
    visibility = ["//visibility:public"],
    deps = _GO_DEPS,
)

go_test(
    name = "ffi_test",
    size = "small",
    srcs = glob(["*_test.go"], exclude = [
        "reconstructed_test.go",
        "replay_test.go",
    ]),
    embed = [":ffi_ethhash"],
    deps = [
        "@com_github_prometheus_client_model//go",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
